# Lokasi file database SQLite (relatif terhadap root project)
DATABASE_URL="file:./data/app.db"

# Rahasia untuk menandatangani sesi admin. Buat dengan: openssl rand -hex 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Akun admin pertama (dipakai oleh `npm run db:seed`, hanya jika belum ada admin)
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD="ganti-password-ini"

# Folder penyimpanan gambar yang diunggah dari panel admin
UPLOAD_DIR="./uploads"

# URL publik situs (untuk sitemap dan metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
